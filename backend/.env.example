DATABASE_URL=postgres://user:password@localhost:5432/hr_recruitment
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5500
PORT=3001

# Optional: auto-create an initial admin on startup if it doesn't exist.
# Handy for fresh deployments (e.g. Render) — no need to run a script.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Email scanning (OAuth). Leave a provider's vars empty to hide its connect button.
# 32-byte key, base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=
# Base URL of THIS backend, used to build OAuth redirect URIs (no trailing slash)
OAUTH_REDIRECT_BASE=http://localhost:3001
# Google (Gmail) — from Google Cloud Console OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Outlook) — from Azure Entra app registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
